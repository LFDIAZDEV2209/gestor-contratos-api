# ==== Entorno ====
NODE_ENV=development
PORT=4000

# ==== PostgreSQL (docker-compose.yml) ====
DB_HOST=localhost
DB_PORT=5433
DB_USER=gestor
DB_PASSWORD=gestor_demo_2026
DB_NAME=gestor_contratos

# ==== Auth (JWT de demo; en producción se reemplaza por SSO OIDC, ver files/10) ====
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES=12h

# ==== CORS ====
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==== Worker de alertas (recalculo diario, cron estándar) ====
ALERT_CRON=0 6 * * *

# ==== Almacenamiento local de archivos (fase 2: blob storage Azure/S3) ====
UPLOAD_DIR=./data/uploads

# ==== Paginación por defecto ====
DEFAULT_PAGE_SIZE=25
